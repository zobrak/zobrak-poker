      position: "{{ p.position }}"
      stack_bb: {{ p.stack_bb }}
      is_hero: {{ "true" if p.is_hero else "false" }}
      avatar: "{{ p.avatar }}"
      vpip: {{ p.vpip }}
      pfr: {{ p.pfr }}
      three_bet: {{ p.three_bet }}
      hands: {{ p.hands }}
{% endfor %}
